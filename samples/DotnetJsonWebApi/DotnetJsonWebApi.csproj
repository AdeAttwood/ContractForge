<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.0" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.OpenApi" Version="1.6.25" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Ndjson.AsyncStreams.AspNetCore.Mvc" Version="1.4.1" />
  </ItemGroup>

  <Target Name="ContractForge"  BeforeTargets="CoreCompile">
    <Exec Command="dotnet run --project ../../src/ContractForge.Cli/ContractForge.Cli.csproj -- -e ./calculator.thrift -g csharp-jsonapi -o Generated/CalculatorService.cs" />
  </Target>
</Project>
