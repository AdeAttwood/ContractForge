<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0-rc.1.25451.107" />
    <PackageReference Include="Ndjson.AsyncStreams.AspNetCore.Mvc" Version="1.4.1" />
  </ItemGroup>

  <Target Name="RpcNet"  BeforeTargets="CoreCompile">
    <Exec Command="dotnet run --project ../../src/NetRpc.Cli/NetRpc.Cli.csproj -- -e ./calculator.thrift -g csharp-jsonapi -o Generated/CalculatorService.cs" />
  </Target>
</Project>
